# Copy to .env.local. Everything is optional in development (the Vite proxy handles /api).
# Where the dev proxy forwards /api, /uploads and /socket.io:
VITE_API_PROXY=http://localhost:6000/api/v1
# Production: full API base URL and socket origin (leave empty to use same-origin "/api/v1")
VITE_API_BASE_URL=
VITE_SOCKET_URL=
# Social sign-in (buttons are hidden when the id is empty)
VITE_GOOGLE_CLIENT_ID=461111182455-mgqckud1p81glo44tac87s7r97731hjp.apps.googleusercontent.com
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=
# Links in the register form / footer
VITE_TERMS_URL=
VITE_PRIVACY_URL=
